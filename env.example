# Configurações básicas do servidor
PORT=3000
NODE_ENV=development
URLBASE=http://localhost:${PORT}
MAX_REQUEST_SIZE=10mb
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# Configurações de sessão
SESSION_TIMEOUT=24
SESSION_MAX_RECONNECT_ATTEMPTS=5
SESSION_RECONNECT_DELAY=10000
SESSION_HEALTH_CHECK_INTERVAL=30000

# Configurações de autenticação básica (legado)
BASIC_AUTH_USER=admin
BASIC_AUTH_PASSWORD=admin@password

# Configurações JWT (ALTERE EM PRODUÇÃO)
JWT_SECRET=sua_jwt_secret_super_secreta_aqui_com_pelo_menos_32_caracteres
JWT_REFRESH_SECRET=sua_jwt_refresh_secret_super_secreta_aqui_com_pelo_menos_32_caracteres
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=dynamuszap-api
JWT_AUDIENCE=dynamuszap-client

# API Keys válidas (separadas por vírgula)
# Gere novas keys usando: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VALID_API_KEYS=3fb57b986314face5622a786d7c6f8d68b2d2c8df1db6bfbc53589ab299bc19e

# Configurações HTTPS/SSL
ENABLE_HTTPS=false
SSL_KEY_PATH=/path/to/private.key
SSL_CERT_PATH=/path/to/certificate.crt

# Configurações de Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Configurações CORS (origins permitidas, separadas por vírgula)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Configurações de logs
ENABLE_ACCESS_LOGS=true
LOG_LEVEL=info

# Timeout de requisições (milissegundos)
REQUEST_TIMEOUT=30000

# Bot WhatsApp
BOT_ATIVO=N

# Configurações da Queue
QUEUE_CONCURRENT=1
QUEUE_MAX_RETRIES=3
QUEUE_RETRY_DELAY=${PORT}

# Configurações de ambiente para Docker
DOCKER_ENV=false 